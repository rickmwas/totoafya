{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "TotoAfya Mother Experience Design Tokens",
  "version": "1.0.0",
  "theme": "The Sunlit Botanical Editorial",
  "colors": {
    "brand": {
      "teal": {
        "deep": "#004D44",
        "primary": "#006B5F",
        "medium": "#2E8A74",
        "soft": "#E6F4F1"
      },
      "amber": {
        "deep": "#B45309",
        "primary": "#E68A00",
        "soft": "#FEF3C7",
        "subtle": "#FFFBEB"
      },
      "crimson": {
        "primary": "#DC2626",
        "soft": "#FEE2E2",
        "subtle": "#FEF2F2"
      }
    },
    "canvas": {
      "stone": "#F9F8F5",
      "card": "#FFFFFF",
      "subtle": "#F1EFEA",
      "muted": "#F1EFEA",
      "border": "#E2E8F0",
      "borderFocus": "#006B5F"
    },
    "ink": {
      "primary": "#1A202C",
      "secondary": "#4A5568",
      "muted": "#718096",
      "inverse": "#FFFFFF"
    },
    "status": {
      "healthy": {
        "fg": "#15803D",
        "bg": "#F0FDF4",
        "border": "#A3E0BF",
        "contrastOnBg": "5.14:1"
      },
      "warning": {
        "fg": "#B45309",
        "bg": "#FFFBEB",
        "border": "#FDE68A",
        "contrastOnBg": "5.22:1"
      },
      "critical": {
        "fg": "#DC2626",
        "bg": "#FEF2F2",
        "soft": "#FEE2E2",
        "border": "#FCA5A5",
        "contrastOnBg": "4.80:1"
      },
      "info": {
        "fg": "#1D4ED8",
        "bg": "#EFF6FF",
        "border": "#93C5FD",
        "contrastOnBg": "5.60:1"
      },
      "scheduled": {
        "fg": "#006B5F",
        "bg": "#E6F4F1",
        "border": "#99D5CE"
      },
      "upcoming": {
        "fg": "#4A5568",
        "bg": "#F1EFEA",
        "border": "#E2E8F0"
      }
    },
    "contrastRules": {
      "darkOnAmberMandatory": true,
      "amberPrimaryHex": "#E68A00",
      "outlawedTextHex": "#FFFFFF",
      "outlawedContrast": "2.40:1",
      "mandatoryTextHex": "#1A202C",
      "mandatoryContrast": "6.71:1"
    }
  },
  "spacing": {
    "gridBase": 8,
    "scale": {
      "0": 0,
      "2xs": 2,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "base": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64
    },
    "swahiliButtonPadding": 20
  },
  "typography": {
    "fontFamily": {
      "display": "Merriweather, Georgia, serif",
      "serif": "Merriweather, Georgia, serif",
      "sans": "\"Plus Jakarta Sans\", Inter, system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", \"SF Mono\", Consolas, monospace"
    },
    "modularScale": {
      "display-hero": {
        "fontSize": 32,
        "lineHeight": 40,
        "fontWeight": "700",
        "letterSpacing": "-0.02em",
        "fontFamily": "Merriweather"
      },
      "title-large": {
        "fontSize": 24,
        "lineHeight": 32,
        "fontWeight": "700",
        "letterSpacing": "-0.01em",
        "fontFamily": "Merriweather"
      },
      "title-medium": {
        "fontSize": 18,
        "lineHeight": 26,
        "fontWeight": "600",
        "letterSpacing": "-0.01em",
        "fontFamily": "Plus Jakarta Sans"
      },
      "body-large": {
        "fontSize": 16,
        "lineHeight": 24,
        "fontWeight": "400",
        "letterSpacing": "0.00em",
        "fontFamily": "Plus Jakarta Sans"
      },
      "body-medium": {
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": "400",
        "letterSpacing": "0.00em",
        "fontFamily": "Plus Jakarta Sans"
      },
      "label-action": {
        "fontSize": 14,
        "lineHeight": 18,
        "fontWeight": "600",
        "letterSpacing": "+0.01em",
        "fontFamily": "Plus Jakarta Sans"
      },
      "caption": {
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": "500",
        "letterSpacing": "+0.01em",
        "fontFamily": "Plus Jakarta Sans"
      },
      "data-metric": {
        "fontSize": 22,
        "lineHeight": 28,
        "fontWeight": "700",
        "letterSpacing": "-0.02em",
        "fontFamily": "Plus Jakarta Sans",
        "features": "tabular-nums"
      }
    }
  },
  "radii": {
    "sm": 6,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999,
    "card-sm": 12,
    "card-md": 16,
    "card-lg": 24
  },
  "shadows": {
    "card": "0 2px 8px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02)",
    "sheet": "0 -4px 20px rgba(0, 0, 0, 0.08)",
    "button": "0 4px 14px rgba(0, 107, 95, 0.25)",
    "tealGlow": "0 8px 24px rgba(0, 107, 95, 0.22)",
    "amberGlow": "0 8px 24px rgba(230, 138, 0, 0.22)"
  },
  "touchTarget": {
    "minSize": 48,
    "clearance": 8,
    "standard": "48px x 48px"
  },
  "safeArea": {
    "top": "env(safe-area-inset-top, 0px)",
    "bottom": "env(safe-area-inset-bottom, 0px)",
    "left": "env(safe-area-inset-left, 0px)",
    "right": "env(safe-area-inset-right, 0px)"
  },
  "swahiliLayout": {
    "expansionRatio": 1.25,
    "minButtonPaddingPx": 20,
    "maxHeaderLines": 2,
    "allowClinicalEllipsis": false
  }
}
